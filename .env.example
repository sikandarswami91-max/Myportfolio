# ==============================================================================
# SIKANDAR PORTFOLIO — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit .env to version control (Git / GitHub).
# - Keep all secrets, database passwords, and private keys strictly confidential.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port for backend / full-stack server (default: 3000 for integrated server, 5000 for standalone backend)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. from MongoDB Atlas Cluster)
# Format: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Strong random secret key used to sign and verify JSON Web Tokens (min 32 characters)
# Generate a secure key with: openssl rand -base64 32
JWT_SECRET=

# Initial Administrator credentials (used for seeding the private admin dashboard)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 4. CLOUDINARY STORAGE (Project Screenshots & Resume PDF)
# ------------------------------------------------------------------------------
# Obtain from Cloudinary Console Dashboard (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 5. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Allowed frontend origins separated by commas (for decoupled frontend)
# Local: http://localhost:5173
# Production example: https://your-portfolio.vercel.app
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 6. FRONTEND CLIENT CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
# Public API URL accessible from the client browser
# - Leave EMPTY for unified full-stack server or reverse-proxy (uses relative '/api')
# - Set to your deployed backend URL when deploying frontend separately to Vercel/Netlify:
#   Example: https://your-portfolio-api.onrender.com
VITE_API_URL=
