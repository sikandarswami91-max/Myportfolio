# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES TEMPLATE (Vite)
# ==============================================================================
# Copy this file to frontend/.env for local frontend development:
#   cp frontend/.env.example frontend/.env
#
# IMPORTANT SECURITY RULE:
# Variables starting with VITE_ are public and bundled into frontend JavaScript.
# NEVER put private API secrets, database passwords, or JWT secrets in frontend!
# ==============================================================================

# Backend API base URL:
# - Leave empty when using Vite reverse-proxy or unified full-stack server (uses relative '/api')
# - Set to backend domain when frontend is deployed separately on Vercel:
#   Example: https://your-portfolio-backend.onrender.com
VITE_API_URL=

# Backend server address for Vite standalone dev proxy (default: http://localhost:5000)
VITE_BACKEND_URL=http://localhost:5000
